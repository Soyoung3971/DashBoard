# Supabase 연결 문자열 (자습·특강 사이트와 같은 값, Transaction Pooler 주소 권장)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# iron-session 쿠키 서명 키 — 아무 문자열 32자 이상 (자습·특강 사이트와 같은 값이어야 쿠키를 공유한다)
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
